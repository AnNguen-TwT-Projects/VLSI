// KSA8: sinh tu dong boi blocks/gen_blocks.py - khong sua tay
// Can include cac cell A + stub XOR2/XNOR2 va cac khoi con truoc khi dung.
simulator lang=spectre
subckt KSA8 A_0 A_1 A_2 A_3 A_4 A_5 A_6 A_7 B_0 B_1 B_2 B_3 B_4 B_5 B_6 B_7 CIN S_0 S_1 \
    S_2 S_3 S_4 S_5 S_6 S_7 C7 C8 VDD VSS
I0 (A_0 B_0 gn0 VDD VSS) NAND2_X1
I1 (A_1 B_1 gn1 VDD VSS) NAND2_X1
I2 (A_2 B_2 gn2 VDD VSS) NAND2_X1
I3 (A_3 B_3 gn3 VDD VSS) NAND2_X1
