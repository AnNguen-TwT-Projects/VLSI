; Assura LVS cho mot cell (thu vien @LIB@): layout so voi netlist CDL virtuoso/cdl/<CELL>.cdl.
; @LIB@, @CELL@, @RUN@, @CDL@ do virtuoso/run_layout_cell.sh dien vao.
avParameters(
  ?inputLayout ( "df2" "@LIB@" )
  ?cellName "@CELL@"
  ?viewName "layout"
  ?rulesFile "/home/buet/cadence/gpdk090_v4.6/assura/extract.rul"
  ?runName "@CELL@"
  ?workingDirectory "@RUN@"
  ?overwrite t
  ?avrpt t
)
load( "/home/buet/cadence/gpdk090_v4.6/assura/compare.rul" )
avCompareRules(
  schematic(
    netlist( cdl "@CDL@" )
  )
  bindingFile( "/home/buet/cadence/gpdk090_v4.6/assura/bind.rul" )
  bind( net("*[*]" "*<*>") )
  mergeSplitGate( sameOrder )
  autoPinSwap( t 3000 )
  expandOnError( (pins t) (swap t) (reduce t) (swapThres t) )
)
avLVS()
