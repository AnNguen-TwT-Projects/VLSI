// S = A^B^CI, CO = maj(A,B,CI). 28T mirror adder.
// Pins: A B CI S CO VDD VSS. 28 transistors.
simulator lang=spectre
subckt FA_X1 A B CI S CO VDD VSS
    MN1 (n1 A VSS VSS) gpdk090_nmos1v w=0.24u l=0.1u
    MN2 (con B n1 VSS) gpdk090_nmos1v w=0.24u l=0.1u
    MN3 (n2 A VSS VSS) gpdk090_nmos1v w=0.24u l=0.1u
