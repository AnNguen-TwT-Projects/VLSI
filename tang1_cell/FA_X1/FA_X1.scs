    MN7 (n3 B VSS VSS) gpdk090_nmos1v w=0.24u l=0.1u
    MN8 (n3 CI VSS VSS) gpdk090_nmos1v w=0.24u l=0.1u
    MN9 (sn con n3 VSS) gpdk090_nmos1v w=0.24u l=0.1u
    MN10 (n4 A VSS VSS) gpdk090_nmos1v w=0.36u l=0.1u
    MN11 (n5 B n4 VSS) gpdk090_nmos1v w=0.36u l=0.1u
    MN12 (sn CI n5 VSS) gpdk090_nmos1v w=0.36u l=0.1u
    MP13 (p1 A VDD VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP14 (con B p1 VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP15 (p2 A VDD VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP16 (p2 B VDD VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP17 (con CI p2 VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP18 (p3 A VDD VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP19 (p3 B VDD VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP20 (p3 CI VDD VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP21 (sn con p3 VDD) gpdk090_pmos1v w=0.48u l=0.1u
    MP22 (p4 A VDD VDD) gpdk090_pmos1v w=0.72u l=0.1u
