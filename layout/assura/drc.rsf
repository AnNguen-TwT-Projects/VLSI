; Assura DRC run file for one cell (library @LIB@) (gpdk090 drc.rul, default switches:
; no CHECK_DFM; density/antenna are separate rule sets and are not run on single cells).
; @LIB@, @CELL@ and @RUN@ are filled in by layout/run_layout_A.sh.
avParameters(
  ?inputLayout ( "df2" "@LIB@" )
  ?cellName "@CELL@"
  ?viewName "layout"
  ?rulesFile "/home/buet/cadence/gpdk090_v4.6/assura/drc.rul"
  ?runName "@CELL@"
  ?workingDirectory "@RUN@"
  ?flagNon45 t
  ?userUnits "micron"
  ?overwrite t
  ?avrpt t
)
